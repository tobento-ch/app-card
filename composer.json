{
    "name": "tobento/app-card",
    "version": "2.0.2",
    "type": "library",
    "description": "App card support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "card",
        "cards"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-support": "^2.0",
        "maantje/charts": "^0.8.1"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-testing": "^2.0",
        "tobento/service-container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Card\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Card\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}